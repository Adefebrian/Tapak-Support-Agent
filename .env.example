# Tapak Support Agent configuration. Copy to .env and fill in.
PORT=8787

# LLM provider: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# JEV decision layer (TypeSafe System One). Advisory only, fail closed.
# JEV_PROVIDER: jev | mock | noop. JEV_ENABLED=false forces noop.
JEV_ENABLED=false
JEV_PROVIDER=mock
JEV_API_KEY=

# Comma-separated extra CORS origins (Tauri schemes are always allowed)
CORS_ORIGINS=http://localhost:8787

DB_PATH=data/tapak.db
