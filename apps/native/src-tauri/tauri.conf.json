{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tapak Support",
  "version": "0.1.0",
  "identifier": "id.tapak.support",
  "build": {
    "beforeBuildCommand": "bun run --cwd ../client build",
    "beforeDevCommand": "bun run --cwd ../client build",
    "frontendDist": "../../server/public"
  },
  "app": {
    "windows": [
      {
        "title": "Tapak Support",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
